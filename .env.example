# Required: Solana wallet whose transactions are monitored
WALLET_ADDRESS=REPLACE_WITH_PUBLIC_WALLET_ADDRESS

# Required by Config::load for signing initialization.
# Use a NEW, dedicated test wallet. Never commit a real private key.
PRIVATE_KEY_BYTES=REPLACE_WITH_BASE58_PRIVATE_KEY

# At least one HTTP RPC endpoint is required
RPC_URL=https://api.mainnet-beta.solana.com

# Optional WebSocket endpoint (defaults to public Solana mainnet)
WEBSOCKET_URL=wss://api.mainnet-beta.solana.com
# FAST_WS_ENDPOINT=wss://YOUR_PROVIDER_ENDPOINT
# FAST_RPC_ENDPOINT=https://YOUR_PROVIDER_ENDPOINT

# Optional Jupiter endpoints and processing settings
JUPITER_QUOTE_URL_PRIMARY=https://api.jup.ag/swap/v1/quote
JUPITER_SWAP_URL_PRIMARY=https://api.jup.ag/swap/v1/swap
MAX_WORKERS=4
BUY_AMOUNT_SOL=0.01
MIRROR_BUY_MODE=false
MIRROR_MIN_SOL=0.001
MIRROR_MAX_SOL=1.0

# This variable is parsed, but the trading engine does not currently use it
# as an execution gate. Transaction submission is commented out in source.
AUTO_TRADE_ENABLED=false
